# ------------------------------------------------------------------
# Pendik Akıllı Lojistik & Rota Optimizasyon Sistemi — Ortam Değişkenleri
# ------------------------------------------------------------------
# Bu dosyayı ".env.local" olarak kopyalayın ve değerleri kendi
# ortamınıza göre düzenleyin:
#     cp .env.example .env.local
#
# NOT: "NEXT_PUBLIC_" ön ekli değişkenler tarayıcıya gömülür; buraya
# GİZLİ ANAHTAR / ŞİFRE koymayın. Tümü opsiyoneldir — tanımlanmazsa
# aşağıdaki genel (public) servisler kullanılır.
# ------------------------------------------------------------------

# OSRM rota optimizasyon sunucusu (TSP/VRP — Trip & Route API).
# Üretimde kendi OSRM örneğinizi kurmanız şiddetle önerilir; genel
# demo sunucusunun oran (rate) limiti vardır ve SLA garantisi yoktur.
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# OpenStreetMap Nominatim geocoding uç noktası (adres -> koordinat).
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Nominatim istekleri arası minimum gecikme (ms). OSM kullanım
# politikası gereği genel sunucuda 1000 ms (saniyede 1 istek) altına
# İNMEYİN. Self-hosted sunucuda düşürebilirsiniz.
NEXT_PUBLIC_NOMINATIM_RATE_LIMIT_MS=1000

# ------------------------------------------------------------------
# Canlı Şoför Paylaşımı (Live Route Sharing) — SUNUCU TARAFI
# ------------------------------------------------------------------
# Bunlar SUNUCU tarafı gizli değerlerdir; "NEXT_PUBLIC_" ÖN EKİ YOKTUR
# ve tarayıcıya gömülmez. Şoför QR/linkleri için rota paylaşımını
# KALICI ve çok-cihazlı hale getirir (örn. Vercel deploy).
#
# Boş bırakılırsa sistem otomatik olarak GEÇİCİ (in-memory) depolamaya
# düşer: tek süreçli "npm run dev" ile telefon testi için yeterlidir,
# ancak sunucu yeniden başlarsa veya çok-örnekli (serverless) ortamda
# çalışırsa paylaşım kaybolur.
#
# Ücretsiz kurulum: https://upstash.com → yeni Redis veritabanı oluşturun
# → "REST API" sekmesinden aşağıdaki iki değeri kopyalayın. Vercel'de bu
# ikisini Project Settings > Environment Variables'a ekleyin.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
